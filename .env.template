# Copy to the repository-root .env and fill only the keys you need.
# Never commit .env or paste credentials into this template.
# Offline reproduction, submission checks, and dummy runs need no keys.

# Judges: direct provider APIs through the LiteLLM Python client.
# Gemini uses Google's Gemini API; DeepSeek uses https://api.deepseek.com/beta.
# Neither judge uses OpenRouter or a LiteLLM proxy.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional solver credentials: use the key named by your YAML's api_key_env_var.
# Solver commands load .env explicitly: uv run --env-file .env riddles-framework ...
# Judge commands load the root .env automatically; existing shell values win.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
